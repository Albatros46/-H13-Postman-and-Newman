{
  "info": {
    "_postman_id": "42e1296e-8cca-53d7-a5d7-8d6e66992577",
    "name": "Restful Booker API",
    "description": "API tests for https://restful-booker.herokuapp.com — auth, booking CRUD with request chaining, JSON Schema validation, negative and security checks. Known defects are tagged [KNOWN BUG BR-xx] and described in DEFECTS.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs before EVERY request. Test data is created once per run (at the first request),",
          "// so the data is unique and the run does not depend on bookings someone else left on the",
          "// public server. In the Postman app collection variables survive between runs, hence the reset.",
          "if (pm.info.requestName === 'Ping' || !pm.collectionVariables.get('runId')) {",
          "    const isoDate = (daysFromToday) => {",
          "        const d = new Date();",
          "        d.setUTCDate(d.getUTCDate() + daysFromToday);",
          "        return d.toISOString().slice(0, 10);",
          "    };",
          "    pm.collectionVariables.set('runId', Date.now().toString(36));",
          "    pm.collectionVariables.set('firstname', pm.variables.replaceIn('{{$randomFirstName}}'));",
          "    pm.collectionVariables.set('lastname', 'QA-' + pm.collectionVariables.get('runId'));",
          "    pm.collectionVariables.set('totalprice', String(100 + Math.floor(Math.random() * 900)));",
          "    pm.collectionVariables.set('checkin', isoDate(30));",
          "    pm.collectionVariables.set('checkout', isoDate(35));",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs after EVERY request in this collection.",
          "const maxMs = Number(pm.environment.get('maxResponseMs') || 3000);",
          "if (pm.info.requestName !== 'Ping') { // the first call may wake up a sleeping server",
          "    pm.test(`response time is below ${maxMs} ms`, () => {",
          "        pm.expect(pm.response.responseTime).to.be.below(maxMs);",
          "    });",
          "}"
        ]
      }
    }
  ],
