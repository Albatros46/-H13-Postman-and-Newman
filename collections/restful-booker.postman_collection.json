                  "// Expected: 400. Actual: the booking is stored.",
                  "pm.test('[KNOWN BUG BR-03] negative price and checkout before checkin are accepted', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const booking = pm.response.json().booking;",
                  "    pm.expect(booking.totalprice).to.be.below(0);",
                  "    pm.expect(booking.bookingdates.checkout < booking.bookingdates.checkin).to.be.true;",
