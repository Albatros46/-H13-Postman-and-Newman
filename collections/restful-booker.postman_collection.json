                  "        bookingdates: {",
                  "            type: 'object',",
                  "            required: ['checkin', 'checkout'],",
                  "            additionalProperties: false,",
                  "            properties: {",
                  "                checkin: { type: 'string', pattern: '^\\\\d{4}-\\\\d{2}-\\\\d{2}$' },",
                  "                checkout: { type: 'string', pattern: '^\\\\d{4}-\\\\d{2}-\\\\d{2}$' }",
                  "            }",
                  "        },",
                  "        additionalneeds: { type: 'string' }",
                  "    }",
                  "};",
                  "",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('response matches the booking schema', () => pm.expect(body).to.be.jsonSchema(bookingSchema));",
                  "pm.test('price and deposit are updated', () => {",
                  "    pm.expect(body.totalprice).to.eql(999);",
                  "    pm.expect(body.depositpaid).to.eql(false);",
                  "});",
                  "",
                  "// PUT replaces the whole resource, so a field left out should be gone.",
                  "pm.test('[KNOWN BUG BR-04] PUT keeps \"additionalneeds\" although it was not sent', () => {",
                  "    pm.expect(body.additionalneeds).to.eql('Breakfast');",
                  "});",
                  "pm.collectionVariables.set('expectedBooking', JSON.stringify(body));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
