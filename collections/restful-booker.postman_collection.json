        {
          "name": "Cleanup: delete negative-test bookings",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The second booking from this folder is deleted with a direct call; Postman/Newman",
                  "// can send a request from a script, so cleanup does not need its own entry for each id.",
                  "const invalidId = pm.collectionVariables.get('invalidBookingId');",
                  "if (invalidId) {",
                  "    pm.sendRequest({",
                  "        url: pm.variables.replaceIn('{{baseUrl}}/booking/' + invalidId),",
                  "        method: 'DELETE',",
                  "        header: { Cookie: 'token=' + pm.collectionVariables.get('token') }",
                  "    }, (err, res) => {",
                  "        if (err || res.code !== 201) {",
                  "            console.warn('cleanup of booking ' + invalidId + ' failed: ' + (err || res.code));",
                  "        }",
                  "    });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('booking deleted (201, see BR-05)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{negativeBookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{negativeBookingId}}"
              ]
            }
          }
        }
