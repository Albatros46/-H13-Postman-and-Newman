    {
      "name": "03 Booking lifecycle",
      "description": "Create → read → find → update → partial update → delete, chained through collection variables.",
      "item": [
        {
          "name": "Create booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const bookingSchema = {",
                  "    type: 'object',",
                  "    required: ['firstname', 'lastname', 'totalprice', 'depositpaid', 'bookingdates'],",
                  "    additionalProperties: false,",
                  "    properties: {",
                  "        firstname: { type: 'string' },",
                  "        lastname: { type: 'string' },",
                  "        totalprice: { type: 'number' },",
                  "        depositpaid: { type: 'boolean' },",
                  "        bookingdates: {",
                  "            type: 'object',",
                  "            required: ['checkin', 'checkout'],",
                  "            additionalProperties: false,",
                  "            properties: {",
                  "                checkin: { type: 'string', pattern: '^\\\\d{4}-\\\\d{2}-\\\\d{2}$' },",
                  "                checkout: { type: 'string', pattern: '^\\\\d{4}-\\\\d{2}-\\\\d{2}$' }",
                  "            }",
                  "        },",
                  "        additionalneeds: { type: 'string' }",
                  "    }",
                  "};",
                  "",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('response matches the booking schema', () => {",
                  "    pm.expect(body.bookingid, 'bookingid').to.be.a('number');",
                  "    pm.expect(body.booking).to.be.jsonSchema(bookingSchema);",
                  "});",
                  "",
                  "pm.test('the booking echoes the request', () => {",
                  "    pm.expect(body.booking).to.eql(JSON.parse(pm.request.body.raw.replace(/{{(\\w+)}}/g,",
                  "        (_, name) => pm.variables.get(name))));",
                  "});",
                  "",
                  "// Chaining: the next requests use this id",
                  "pm.collectionVariables.set('bookingId', body.bookingid);",
                  "pm.collectionVariables.set('expectedBooking', JSON.stringify(body.booking));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"{{firstname}}\",\n    \"lastname\": \"{{lastname}}\",\n    \"totalprice\": {{totalprice}},\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"{{checkin}}\",\n        \"checkout\": \"{{checkout}}\"\n    },\n    \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const bookingSchema = {",
                  "    type: 'object',",
                  "    required: ['firstname', 'lastname', 'totalprice', 'depositpaid', 'bookingdates'],",
                  "    additionalProperties: false,",
                  "    properties: {",
                  "        firstname: { type: 'string' },",
                  "        lastname: { type: 'string' },",
                  "        totalprice: { type: 'number' },",
                  "        depositpaid: { type: 'boolean' },",
                  "        bookingdates: {",
                  "            type: 'object',",
                  "            required: ['checkin', 'checkout'],",
                  "            additionalProperties: false,",
                  "            properties: {",
                  "                checkin: { type: 'string', pattern: '^\\\\d{4}-\\\\d{2}-\\\\d{2}$' },",
                  "                checkout: { type: 'string', pattern: '^\\\\d{4}-\\\\d{2}-\\\\d{2}$' }",
                  "            }",
                  "        },",
                  "        additionalneeds: { type: 'string' }",
                  "    }",
                  "};",
                  "",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('response matches the booking schema', () => pm.response.to.have.jsonSchema(bookingSchema));",
                  "pm.test('stored booking equals the created one', () => {",
                  "    pm.expect(pm.response.json()).to.eql(JSON.parse(pm.collectionVariables.get('expectedBooking')));",
                  "});"
                ]
