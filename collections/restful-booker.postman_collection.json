    {
      "name": "02 Auth",
      "description": "Token-based login.",
      "item": [
        {
          "name": "Create token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('a token is returned', () => {",
                  "    pm.expect(body.token, 'token').to.be.a('string').and.match(/^[0-9a-f]{15}$/);",
                  "});",
                  "",
                  "// The token is a secret: it goes into a collection variable for the next requests",
                  "// and is never printed (the HTML report hides this request's body and all Cookie headers).",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Logs in and stores the token in the collection variable `token`."
          }
        },
        {
          "name": "Bad credentials are rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test('no token is returned', () => pm.expect(body).to.not.have.property('token'));",
                  "pm.test('reason is \"Bad credentials\"', () => pm.expect(body.reason).to.eql('Bad credentials'));",
                  "",
                  "// Expected: 401 Unauthorized. Actual: 200 OK.",
                  "pm.test('[KNOWN BUG BR-01] wrong password returns 200 instead of 401', () => {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
